{
  "name": "original",
  "truth": {"BANK": "신한", "ACCOUNT": "110234567890", "AMOUNT": "32000", "NAME": "김철수"},
  "note": "The SOL transfer prototype - 8 task screens, aligned to the Flutter dummy app A1 transfer (2026-10-05); the two error popups (err-account, err-bank) are screens too but the happy path does not visit them. derived_from_original means the build under test is a repair of this same document, so structural preservation can be asserted.",
  "derived_from_original": true,
  "required_ids": ["phone", "grid-bank", "grid-sec", "tab-bank", "tab-sec",
                   "picked-bank", "acc-input", "acc-next", "amt-acc",
                   "amt-display", "amt-next", "cf-amt", "cf-acc",
                   "dn-amt", "pw-dots", "pwpad", "amt-bank", "cf-bank"],
  "steps": [
    {"screen": "home"},
    {"screen": "recipient", "click": "[data-action='go-recipient']"},
    {"screen": "account", "click": "[data-action='go-account']"},
    {"screen": "bank", "click": "[data-action='open-bank']"},
    {"screen": "amount", "do": [
      {"click": "[data-action='pick-bank'][data-bank='{BANK}']"},
      {"wait": 0.3},
      {"type": "{ACCOUNT}", "key": "[data-action='acc-num'][data-v='%s']"},
      {"click": "#acc-next"}
    ]},
    {"screen": "confirm", "do": [
      {"type": "{AMOUNT}", "key": "[data-action='num'][data-v='%s']"},
      {"click": "#amt-next"}
    ]},
    {"screen": "password", "click": "[data-action='send']"},
    {"screen": "done", "do": [
      {"repeat": 4, "click": "#pwpad [data-action='pw']", "wait": 0.15}
    ]}
  ],
  "expect": {
    "amount": [["#amt-bank", "{BANK}"], ["#amt-acc", "{ACCOUNT}"]],
    "confirm": [["#cf-bank", "{BANK}"], ["#cf-acc", "{ACCOUNT}"], ["#cf-amt", "{AMOUNT_SHOWN}"]],
    "done": [["#dn-amt", "{AMOUNT_SHOWN}"]]
  },
  "done_amount": "#dn-amt"
}
