font-size:15px; font-weight:600;}\n  .svc .t2{font-size:12px; color:#8A8F98; margin-top:2px;}\n  .pointbar{margin:0 14px 12px; background:linear-gradient(90deg,#3D6FE8,#5B7FF0); border-radius:16px;\n    padding:16px 18px; color:#fff; display:flex; align-items:center; justify-content:space-between;}\n  .pointbar .p1{font-size:12px; opacity:.85;} .pointbar .p2{font-size:20px; font-weight:700;}\n  .pointbar button{background:#fff; color:var(--blue); border:0; border-radius:8px; padding:7px 14px;\n    font-size:13px; font-weight:700; font-family:inherit;}\n  .tabbar{flex:0 0 62px; display:flex; border-top:1px solid var(--line); background:#fff;}\n  .tabbar div{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;\n    gap:3px; font-size:11px; color:#9AA0A8;}\n  .tabbar div.act{color:var(--blue); font-weight:700;}\n  .tabbar .ti{font-size:18px;}\n  .footlinks{display:flex; justify-content:space-around; padding:16px 0 22px; font-size:13px; color:#5A6069;}\n\n  /* ---------- 2. 받는 사람 ---------- */\n  .h1{font-size:25px; font-weight:700; padding:6px 20px 18px;}\n  .inputline{margin:0 20px; border-bottom:1px solid #DDE1E7; padding-bottom:11px;\n    display:flex; align-items:center; justify-content:space-between;}\n  .inputline .ph{font-size:17px; color:#B4B9C1;}\n  .filterrow{display:flex; align-items:center; justify-content:space-between; padding:14px 20px;}\n  .filterrow .lbl{font-size:15px; font-weight:600; display:flex; align-items:center; gap:7px;}\n  .tag{background:#EFF1F5; border-radius:6px; padding:3px 7px; font-size:11px; color:#6B7280; font-weight:500;}\n  .pill{border:1px solid #E1E4EA; border-radius:16px; padding:6px 13px; font-size:13px; color:#4B5158;}\n  .person{display:flex; align-items:center; gap:12px; padding:11px 20px;}\n  .person .av{width:38px;height:38px;border-radius:50%;flex:0 0 38px;\n    display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;}\n  .person .nm{font-size:15px; font-weight:600;}\n  .person .ac{font-size:13px; color:#6B7280; margin-top:2px;}\n  .person .st{margin-left:auto; font-size:17px; color:#D3D7DD;}\n  .person .st.on{color:var(--blue);}\n\n  /* ---------- 3. 은행 선택 ---------- */\n  .sheetwrap{position:absolute; inset:0; background:rgba(0,0,0,.45); display:none; z-index:5;}\n  .sheetwrap.on{display:block;}\n  .sheet{position:absolute; left:0; right:0; bottom:0; top:96px; background:#fff;\n    border-radius:18px 18px 0 0; display:flex; flex-direction:column;}\n  .sheethead{display:flex; align-items:center; justify-content:space-between; padding:20px 20px 14px;}\n  .sheethead b{font-size:17px;}\n  .tabs{display:flex; border-bottom:1px solid var(--line);}\n  .tabs div{flex:1; text-align:center; padding:13px 0; font-size:15px; color:#9AA0A8;}\n  .tabs div.act{color:#111; font-weight:700; border-bottom:2px solid #111;}\n  .grid{flex:1; overflow-y:auto; display:grid; grid-template-columns:repeat(3,1fr); gap:9px; padding:14px;}\n  .bk{background:#F4F6FA; border-radius:12px; height:88px; display:flex; flex-direction:column;\n    align-items:center; justify-content:center; gap:7px; font-size:12px; font-weight:600;}\n  .bk .bi{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;\n    font-size:12px;color:#fff;font-weight:800;}\n\n  /* ---------- 4. 계좌번호 (임시) ---------- */\n  .tempnote{margin:0 20px 14px; background:#FFF6E5; border:1px solid #FFE0A3; border-radius:10px;\n    padding:10px 12px; font-size:12px; color:#8A6100; line-height:1.5;}\n  .field{margin:0 20px; border-bottom:2px solid var(--blue); padding-bottom:10px;}\n  .field input{width:100%; border:0; outline:0; font-size:22px; font-weight:600; font-family:inherit;\n    letter-spacing:.5px;}\n  .field input::placeholder{color:#C7CBD2; font-weight:400;}\n\n  /* ---------- 5. 금액 ---------- */\n  .amthead{padding:6px 20px 0; font-size:16px; line-height:1.5; color:#4B5158;}\n  .amthead b{color:#111; font-weight:700;}\n  .amtq{text-align:center; font-size:27px; font-weight:700; color:#C7CBD2; margin-top:38px;}\n  .amtq.filled{color:#111;}\n  .amtsub{text-align:center; font-size:14px; color:#8A8F98; margin-top:12px;}\n  .amtsub u{text-decoration-color:#C7CBD2;}\n  .quick{display:flex; gap:8px; padding:0 16px 12px;}\n  .quick button{flex:1; background:#F1F3F7; border:0; border-radius:20px; padding:11px 0;\n    font-size:14px; font-family:inherit; color:#3A3F46;}\n  .keypad{display:grid; grid-template-columns:repeat(3,1fr);}\n  .keypad button{background:#fff; border:0; height:66px; font-size:25px; font-family:inherit; color:#111;}\n  .btn-next{margin:10px 16px 18px; background:#EEF0F4; color:#9AA0A8; border:0; border-radius:12px;\n    padding:17px; font-size:17px; font-weight:700; font-family:inherit;}\n  .btn-next.on{background:var(--blue-deep); color:#fff;}\n\n  /* ---------- 6. 확인 ---------- */\n  .center{text-align:center; padding-top:44px;}\n  .bigav{width:62px;height:62px;border-radius:50%;background:#FEE500;margin:0 auto 22px;\n    display:flex;align-items:center;justify-content:center;font-size:27px;font-weight:900;color:#111;}\n  .q2{font-size:23px; font-weight:700; line-height:1.45;}\n  .fee{font-size:14px; color:#9AA0A8; margin-top:16px;}\n  .summary{background:#F5F6F9; border-radius:13px; margin:34px 20px 0; padding:18px 16px;}\n  .srow{display:flex; justify-content:space-between; align-items:center; padding:7px 0; font-size:14px;}\n  .srow .k{color:#8A8F98;} .srow .v{font-weight:600;}\n  .btn-primary{margin:auto 16px 22px; background:var(--blue-deep); color:#fff; border:0; border-radius:13px;\n    padding:18px; font-size:17px; font-weight:700; font-family:inherit;}\n\n  /* ---------- 7. 비밀번호 ---------- */\n  .pwtitle{text-align:center; font-size:20px; font-weight:700; margin-top:88px;}\n  .dots{display:flex; justify-content:center; gap:19px; margin-top:26px;}\n  .dots i{width:17px;height:17px;border-radius:50%;border:2px solid #D3D7DD; display:block;}\n  .dots i.cur{border-color:var(--blue-deep);}\n  .dots i.fill{background:var(--blue-deep); border-color:var(--blue-deep);}\n  .pwpad{margin-top:auto; background:var(--blue-deep); display:grid; grid-template-columns:repeat(3,1fr);}\n  .pwpad button{background:transparent; border:0; height:96px; color:#fff; font-size:26px; font-family:inherit;}\n  .pwpad button.sm{font-size:16px;}\n\n  /* ---------- 8. 완료 ---------- */\n  .okwrap{text-align:center; padding-top:76px;}\n  .okc{width:64px;height:64px;border-radius:50%;background:var(--blue-deep);margin:0 auto 24px;\n    display:flex;align-items:center;justify-content:center;color:#fff;font-size:31px;}\n  .okbtns{display:flex; gap:9px; justify-content:center; margin-top:26px;}\n  .okbtns button{border:1px solid #DDE1E7; background:#fff; border-radius:10px; padding:11px 18px;\n    font-size:14px; font-family:inherit;}\n  .bottom2{display:flex; gap:9px; margin:auto 16px 22px;}\n  .bottom2 button{flex:1; border:0; border-radius:13px; padding:18px; font-size:17px; font-weight:700; font-family:inherit;}\n  .bottom2 .ghost{background:#EAF0FE; color:var(--blue); flex:0 0 108px;}\n  .bottom2 .fill{background:var(--blue-deep); color:#fff;}\n</style>\n</head>\n<body>\n<div id="phone">\n<section class="screen on" data-screen="amount">\n  <div class="statusbar"><span>1:40</span><span class="right">5G 66</span></div>\n  <div class="navbar"><span class="ico" data-action="back-account">‹</span><span></span><span class="ico" data-action="back-home">✕</span></div>\n  <div class="amthead">\n    [금융거래한도계좌2]신한 주… 계좌에서 ⌄<br>\n    <b>김시현님 계좌로</b><br>\n    <span style="font-size:14px">카카오뱅크 <span id="amt-acc">3333000000000</span></span>\n  </div>\n  <div class="body">\n    <div class="amtq" id="amt-display">얼마를 보낼까요?</div>\n    <div class="amtsub">출금가능금액 <u>100,000</u>원</div>\n  </div>\n  <div class="quick">\n    <button data-action="quick" data-v="10000">+1만</button>\n    <button data-action="quick" data-v="50000">+5만</button>\n    <button data-action="quick" data-v="100