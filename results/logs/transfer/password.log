text-align:center; font-size:27px; font-weight:700; color:#C7CBD2; margin-top:38px;}\n  .amtq.filled{color:#111;}\n  .amtsub{text-align:center; font-size:14px; color:#8A8F98; margin-top:12px;}\n  .amtsub u{text-decoration-color:#C7CBD2;}\n  .quick{display:flex; gap:8px; padding:0 16px 12px;}\n  .quick button{flex:1; background:#F1F3F7; border:0; border-radius:20px; padding:11px 0;\n    font-size:14px; font-family:inherit; color:#3A3F46;}\n  .keypad{display:grid; grid-template-columns:repeat(3,1fr);}\n  .keypad button{background:#fff; border:0; height:66px; font-size:25px; font-family:inherit; color:#111;}\n  .btn-next{margin:10px 16px 18px; background:#EEF0F4; color:#9AA0A8; border:0; border-radius:12px;\n    padding:17px; font-size:17px; font-weight:700; font-family:inherit;}\n  .btn-next.on{background:var(--blue-deep); color:#fff;}\n\n  /* ---------- 6. 확인 ---------- */\n  .center{text-align:center; padding-top:44px;}\n  .bigav{width:62px;height:62px;border-radius:50%;background:#FEE500;margin:0 auto 22px;\n    display:flex;align-items:center;justify-content:center;font-size:27px;font-weight:900;color:#111;}\n  .q2{font-size:23px; font-weight:700; line-height:1.45;}\n  .fee{font-size:14px; color:#9AA0A8; margin-top:16px;}\n  .summary{background:#F5F6F9; border-radius:13px; margin:34px 20px 0; padding:18px 16px;}\n  .srow{display:flex; justify-content:space-between; align-items:center; padding:7px 0; font-size:14px;}\n  .srow .k{color:#8A8F98;} .srow .v{font-weight:600;}\n  .btn-primary{margin:auto 16px 22px; background:var(--blue-deep); color:#fff; border:0; border-radius:13px;\n    padding:18px; font-size:17px; font-weight:700; font-family:inherit;}\n\n  /* ---------- 7. 비밀번호 ---------- */\n  .pwtitle{text-align:center; font-size:20px; font-weight:700; margin-top:88px;}\n  .dots{display:flex; justify-content:center; gap:19px; margin-top:26px;}\n  .dots i{width:17px;height:17px;border-radius:50%;border:2px solid #D3D7DD; display:block;}\n  .dots i.cur{border-color:var(--blue-deep);}\n  .dots i.fill{background:var(--blue-deep); border-color:var(--blue-deep);}\n  .pwpad{margin-top:auto; background:var(--blue-deep); display:grid; grid-template-columns:repeat(3,1fr);}\n  .pwpad button{background:transparent; border:0; height:96px; color:#fff; font-size:26px; font-family:inherit;}\n  .pwpad button.sm{font-size:16px;}\n\n  /* ---------- 8. 완료 ---------- */\n  .okwrap{text-align:center; padding-top:76px;}\n  .okc{width:64px;height:64px;border-radius:50%;background:var(--blue-deep);margin:0 auto 24px;\n    display:flex;align-items:center;justify-content:center;color:#fff;font-size:31px;}\n  .okbtns{display:flex; gap:9px; justify-content:center; margin-top:26px;}\n  .okbtns button{border:1px solid #DDE1E7; background:#fff; border-radius:10px; padding:11px 18px;\n    font-size:14px; font-family:inherit;}\n  .bottom2{display:flex; gap:9px; margin:auto 16px 22px;}\n  .bottom2 button{flex:1; border:0; border-radius:13px; padding:18px; font-size:17px; font-weight:700; font-family:inherit;}\n  .bottom2 .ghost{background:#EAF0FE; color:var(--blue); flex:0 0 108px;}\n  .bottom2 .fill{background:var(--blue-deep); color:#fff;}\n</style>\n</head>\n<body>\n<div id="phone">\n<section class="screen on" data-screen="password">\n  <div class="statusbar"><span>5:55</span><span class="right">5G 89</span></div>\n  <div class="navbar"><span></span><span></span><span class="ico" data-action="back-confirm">✕</span></div>\n  <div class="pwtitle">계좌 비밀번호</div>\n  <div class="dots" id="pw-dots"><i class="cur"></i><i></i><i></i><i></i></div>\n  <div class="pwpad" id="pwpad"><button data-action="pw" data-v="9">9</button><button data-action="pw" data-v="8">8</button><button data-action="pw" data-v="3">3</button><button data-action="pw" data-v="4">4</button><button data-action="pw" data-v="0">0</button><button data-action="pw" data-v="2">2</button><button data-action="pw" data-v="1">1</button><button data-action="pw" data-v="7">7</button><button data-action="pw"