1{font-size:15px; font-weight:600;}\n  .svc .t2{font-size:12px; color:#8A8F98; margin-top:2px;}\n  .pointbar{margin:0 14px 12px; background:linear-gradient(90deg,#3D6FE8,#5B7FF0); border-radius:16px;\n    padding:16px 18px; color:#fff; display:flex; align-items:center; justify-content:space-between;}\n  .pointbar .p1{font-size:12px; opacity:.85;} .pointbar .p2{font-size:20px; font-weight:700;}\n  .pointbar button{background:#fff; color:var(--blue); border:0; border-radius:8px; padding:7px 14px;\n    font-size:13px; font-weight:700; font-family:inherit;}\n  .tabbar{flex:0 0 62px; display:flex; border-top:1px solid var(--line); background:#fff;}\n  .tabbar div{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;\n    gap:3px; font-size:11px; color:#9AA0A8;}\n  .tabbar div.act{color:var(--blue); font-weight:700;}\n  .tabbar .ti{font-size:18px;}\n  .footlinks{display:flex; justify-content:space-around; padding:16px 0 22px; font-size:13px; color:#5A6069;}\n\n  /* ---------- 2. 받는 사람 ---------- */\n  .h1{font-size:25px; font-weight:700; padding:6px 20px 18px;}\n  .inputline{margin:0 20px; border-bottom:1px solid #DDE1E7; padding-bottom:11px;\n    display:flex; align-items:center; justify-content:space-between;}\n  .inputline .ph{font-size:17px; color:#B4B9C1;}\n  .filterrow{display:flex; align-items:center; justify-content:space-between; padding:14px 20px;}\n  .filterrow .lbl{font-size:15px; font-weight:600; display:flex; align-items:center; gap:7px;}\n  .tag{background:#EFF1F5; border-radius:6px; padding:3px 7px; font-size:11px; color:#6B7280; font-weight:500;}\n  .pill{border:1px solid #E1E4EA; border-radius:16px; padding:6px 13px; font-size:13px; color:#4B5158;}\n  .person{display:flex; align-items:center; gap:12px; padding:11px 20px;}\n  .person .av{width:38px;height:38px;border-radius:50%;flex:0 0 38px;\n    display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;}\n  .person .nm{font-size:1