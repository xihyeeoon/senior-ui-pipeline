-items:center; justify-content:space-between; padding:8px 18px 14px; background:var(--bg);}\n  .homehead .name{font-size:19px; font-weight:700; display:flex; align-items:center; gap:7px;}\n  .homehead .dot{width:22px;height:22px;border-radius:50%;background:#FF7A00;color:#fff;font-size:12px;\n    display:flex;align-items:center;justify-content:center;font-weight:700;}\n  .homehead .icons{display:flex; gap:15px; font-size:19px; color:#333;}\n  .card{background:var(--card); border-radius:16px; margin:0 14px 12px; padding:18px 16px;}\n  .card h3{margin:0 0 12px; font-size:19px; font-weight:700; display:flex; justify-content:space-between; align-items:center;}\n  .card h3 span.arr{color:#B9BEC7; font-weight:400; font-size:17px;}\n  .acctrow{display:flex; align-items:flex-start; gap:11px;}\n  .logo{width:34px;height:34px;border-radius:50%;background:#1B4EE8;color:#fff;font-size:15px;\n    display:flex;align-items:center;justify-content:center;flex:0 0 34px;font-weight:700;}\n  .acctname{font-size:12px; color:#6B7280; line-height:1.35;}\n  .acctamt{font-size:20px; font-weight:700; margin-top:3px;}\n  .btn-sm{background:#EAF0FE; color:var(--blue); border:0; border-radius:9px; padding:8px 15px;\n    font-size:14px; font-weight:600; font-family:inherit;}\n  .membership{margin-top:13px; background:#F5F6F9; border-radius:11px; padding:13px; text-align:center;\n    font-size:13px; color:#5A6069;}\n  .btn-wide{width:100%; background:#EAF0FE; color:var(--blue); border:0; border-radius:11px;\n    padding:14px; font-size:15px; font-weight:700; margin-top:14px; font-family:inherit;}\n  .rowlist{display:flex; justify-content:space-around; border-top:1px solid var(--line); margin-top:14px; padding-top:13px;\n    font-size:13px; color:#5A6069;}\n  .svc{display:flex; align-items:center; gap:12px; padding:11px 0;}\n  .svc .sq{width:38px;height:38px;border-radius:11px;background:#EEF1F6;flex:0 0 38px;\n    display:flex;align-items:center;justify-content:center;font-size:16px;}\n  .svc .t1