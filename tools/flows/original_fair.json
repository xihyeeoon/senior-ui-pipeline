{
  "name": "original_fair",
  "note": "원본 흐름과 같지만 구조 보존 검사를 면제한다. 재구성본이 받는 것과 같은 조건에서 규칙 기반 결과가 어떻게 보이는지 확인하기 위한 것. 근거: docs/comparison-validity.md 5절. 원본 흐름 자체는 건드리지 않았다.",
  "derived_from_original": false,
  "required_ids": [
    "phone",
    "grid-bank",
    "grid-sec",
    "tab-bank",
    "tab-sec",
    "picked-bank",
    "acc-input",
    "acc-next",
    "amt-acc",
    "amt-display",
    "amt-next",
    "cf-amt",
    "cf-acc",
    "dn-amt",
    "pw-dots",
    "pwpad"
  ],
  "steps": [
    {
      "screen": "home"
    },
    {
      "screen": "recipient",
      "click": "[data-action='go-recipient']"
    },
    {
      "screen": "account",
      "click": "[data-action='go-account']"
    },
    {
      "screen": "bank",
      "click": "[data-action='open-bank']"
    },
    {
      "screen": "amount",
      "do": [
        {
          "click": "[data-action='pick-bank'][data-bank='{BANK}']"
        },
        {
          "wait": 0.3
        },
        {
          "type": "{ACCOUNT}",
          "key": "[data-action='acc-num'][data-v='%s']"
        },
        {
          "click": "#acc-next"
        }
      ]
    },
    {
      "screen": "confirm",
      "do": [
        {
          "type": "{AMOUNT}",
          "key": "[data-action='num'][data-v='%s']"
        },
        {
          "click": "#amt-next"
        }
      ]
    },
    {
      "screen": "password",
      "click": "[data-action='send']"
    },
    {
      "screen": "done",
      "do": [
        {
          "repeat": 4,
          "click": "#pwpad [data-action='pw']",
          "wait": 0.15
        }
      ]
    }
  ],
  "expect": {
    "amount": [
      [
        "#amt-acc",
        "{ACCOUNT}"
      ]
    ],
    "confirm": [
      [
        "#cf-acc",
        "{ACCOUNT}"
      ],
      [
        "#cf-amt",
        "{AMOUNT_SHOWN}"
      ]
    ],
    "done": [
      [
        "#dn-amt",
        "{AMOUNT_SHOWN}"
      ]
    ]
  },
  "done_amount": "#dn-amt"
}